{% comment %}
  ---------------------------------------------------------------------------
  Dev-only TODO callout.

  Renders a loud amber box in local preview, and NOTHING on the live site —
  the whole thing is wrapped in a check on jekyll.environment, which is
  "development" in Docker (docker-compose.yml) and "production" in the deploy
  workflow (.github/workflows/deploy.yml).

  So you can leave these in place indefinitely: visitors never see them.

  Usage:
    {% include todo.liquid text="Write 2-3 paragraphs on the problem." %}
    {% include todo.liquid label="image" text="Add <code>foo.jpg</code> here." %}
    {% include todo.liquid label="check" text="Confirm this is the right repo." %}

  `text` may contain inline HTML (<code>, <em>, <a>). Liquid does not escape it.
  ---------------------------------------------------------------------------
{% endcomment %}
{% if jekyll.environment != "production" %}
  {% assign _label = include.label | default: "to write" %}
  {% case _label %}
    {% when "image" %}{% assign _c = "#0ea5e9" %}
    {% when "check" %}{% assign _c = "#a855f7" %}
    {% when "review" %}{% assign _c = "#ec4899" %}
    {% else %}{% assign _c = "#f59e0b" %}
  {% endcase %}
  <div style="border-left:4px solid {{ _c }};background:{{ _c }}1f;padding:.7rem .9rem;margin:1rem 0;border-radius:.35rem;font-size:.95rem;line-height:1.5;">
    <span style="display:inline-block;background:{{ _c }};color:#111;font-weight:700;font-size:.65rem;letter-spacing:.08em;text-transform:uppercase;padding:.15rem .45rem;border-radius:.25rem;margin-right:.55rem;vertical-align:.08em;">{{ _label }}</span>{{ include.text }}
  </div>
{% endif %}
