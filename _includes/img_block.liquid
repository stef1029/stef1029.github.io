{% comment %}
  ---------------------------------------------------------------------------
  Self-activating image block.

  Renders a responsive image grid IF every image file exists. If any is
  missing, it renders a dev-only blue note telling you exactly which filenames
  to add — and nothing at all on the live site.

  So: just drop the file into assets/img/projects/ and the image appears.
  There is nothing to uncomment.

  Usage:
    {% include img_block.liquid
       paths="assets/img/projects/rig-hero.jpg"
       titles="The assembled rig"
       caption="What the reader is looking at."
       eager=true
       note="<strong>Hero shot of the rig.</strong> Any angle showing the whole thing." %}

    {% include img_block.liquid cols="3"
       paths="assets/img/projects/a.jpg, assets/img/projects/b.jpg, assets/img/projects/c.jpg"
       titles="CAD | Electronics | Assembled"
       caption="Left to right: ..."
       note="Three-up grid: CAD render, bare board, assembled." %}

  Params:
    paths    - comma-separated image paths, relative to the repo root (required)
    titles   - pipe-separated alt/title text, one per image (optional)
    caption  - caption shown under the grid (optional)
    cols     - 1, 2 or 3 columns at md and up (default: number of paths, max 3)
    width    - cap the block's width and centre it, e.g. width="50%" or "420px".
               Omit for full content width. Useful for near-square diagrams,
               which look enormous at full width on a desktop screen.
    eager    - true to load the first image eagerly (use for a hero image)
    note     - text for the dev-only note shown while images are missing

  WHY THIS EXISTS: do not wrap `figure.liquid` calls in HTML comments. Liquid
  executes before HTML is parsed, so the include still runs, and the HTML it
  emits contains its own `<!-- -->` comment which closes yours early and dumps
  raw markup onto the page.
  ---------------------------------------------------------------------------
{% endcomment %}

{% assign _paths = include.paths | split: "," %}
{% assign _titles = include.titles | split: "|" %}
{% assign _missing = "" %}

{% for _p in _paths %}
  {% assign _clean = _p | strip %}
  {% assign _lookup = _clean | prepend: "/" %}
  {% assign _hit = site.static_files | where: "path", _lookup | first %}
  {% unless _hit %}
    {% assign _missing = _missing | append: "<code>" | append: _clean | append: "</code> " %}
  {% endunless %}
{% endfor %}

{% if _missing == "" %}
  {% assign _cols = include.cols | default: _paths.size %}
  {% if _cols > 3 %}{% assign _cols = 3 %}{% endif %}
  {% capture _style %}{% if include.width %}max-width:{{ include.width }};margin-left:auto;margin-right:auto;{% endif %}{% endcapture %}
  <div class="img-grid img-grid-{{ _cols }}"{% if include.width %} style="{{ _style }}"{% endif %}>
    {% for _p in _paths %}
      {% assign _clean = _p | strip %}
      {% assign _t = _titles[forloop.index0] | default: "" | strip %}
      {% if forloop.first and include.eager %}
        {% include figure.liquid loading="eager" path=_clean title=_t class="img-fluid rounded z-depth-1" %}
      {% else %}
        {% include figure.liquid loading="lazy" path=_clean title=_t class="img-fluid rounded z-depth-1" %}
      {% endif %}
    {% endfor %}
  </div>
  {% if include.caption %}<div class="caption"{% if include.width %} style="{{ _style }}"{% endif %}>{{ include.caption }}</div>{% endif %}
{% else %}
  {% capture _note %}{{ include.note }} <br><em>Add:</em> {{ _missing }}<br><em>They appear here automatically — nothing to uncomment.</em>{% endcapture %}
  {% include todo.liquid label="image" text=_note %}
{% endif %}
